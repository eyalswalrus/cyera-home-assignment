{
  "name": "identityhub-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen:api": "cd ../server && uv run python scripts/export_openapi.py > ../web/src/api/openapi.json && cd ../web && npx -y -p openapi-typescript@7.13.0 -p typescript@5 openapi-typescript src/api/openapi.json --default-non-nullable false -o src/api/schema.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
