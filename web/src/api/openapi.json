    "/api/v1/findings": {
      "post": {
        "tags": [
          "public API v1"
        ],
        "summary": "Create an NHI finding ticket",
        "description": "Creates a Jira issue in `project_key`, acting as the API key's owner.\n\nThe key must be allowed to post to that project, and the owner's Jira account must be able to\ncreate issues there.",
        "operationId": "create_finding_api_v1_findings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindingCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The created Jira issue. `Location` points to it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingCreated"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key"
          },
          "403": {
            "description": "The key lacks the permission or project, or its owner lacks Jira permission"
          },
          "404": {
            "description": "Project not found in Jira, or not visible to the key owner"
          },
          "409": {
            "description": "The key owner's Jira connection needs attention (not connected / reconnect)"
          },
          "422": {
            "description": "Invalid input, or Jira rejected the ticket"
          },
          "429": {
            "description": "Rate limit exceeded; see the Retry-After header"
          },
          "502": {
            "description": "Jira is unavailable"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    }
