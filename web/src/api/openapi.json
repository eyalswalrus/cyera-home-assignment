  "components": {
    "schemas": {
      "Body_auth_session_login_api_auth_login_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_auth_session_login_api_auth_login_post"
      },
      "ConnectionOut": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_connected",
              "active",
              "needs_site",
              "needs_reauth"
            ],
            "title": "Status"
          },
          "site": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SiteOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "account_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Name"
          }
        },
        "type": "object",
        "required": [
          "configured",
          "status"
        ],
        "title": "ConnectionOut"
      },
      "ErrorModel": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorModel"
      },
      "FindingCreate": {
        "properties": {
          "project_key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,19}$",
            "title": "Project Key",
            "examples": [
              "SEC"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Summary",
            "examples": [
              "Stale Service Account: svc-deploy-prod"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 30000,
            "title": "Description",
            "default": ""
          },
          "finding_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FindingType"
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Severity"
              },
              {
                "type": "null"
              }
            ]
          },
          "identity_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Identity Name",
            "examples": [
              "svc-deploy-prod"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_key",
          "summary"
        ],
        "title": "FindingCreate"
      },
      "FindingCreated": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "examples": [
              "SEC-42"
            ]
          },
          "url": {
            "type": "string",
            "title": "Url",
            "examples": [
              "https://acme.atlassian.net/browse/SEC-42"
            ]
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "key",
          "url",
          "summary"
        ],
        "title": "FindingCreated"
      },
      "FindingType": {
        "type": "string",
        "enum": [
          "stale_identity",
          "overprivileged",
          "expiring_credential",
          "exposed_secret",
          "other"
        ],
        "title": "FindingType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
