    "/api/findings/recent": {
      "get": {
        "tags": [
          "findings"
        ],
        "summary": "The 10 newest tickets IdentityHub created in a project",
        "operationId": "recent_findings_api_findings_recent_get",
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "parameters": [
          {
            "name": "project_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,19}$",
              "title": "Project Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecentTicket"
