  "components": {
    "schemas": {
      "ApiKeyCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "GitHub Actions - infra repo"
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes",
            "description": "What the key is used for. Editable later."
          },
          "expires_in_days": {
            "type": "integer",
            "enum": [
              7,
              30,
              90,
              180,
              365
            ],
            "title": "Expires In Days",
            "default": 90
          },
          "permissions": {
            "$ref": "#/components/schemas/ApiKeyPermissions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "permissions"
        ],
        "title": "ApiKeyCreate"
      },
      "ApiKeyCreated": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "prefix": {
            "type": "string",
            "title": "Prefix",
            "description": "First characters of the key, to tell keys apart. Not secret."
          },
          "permissions": {
            "$ref": "#/components/schemas/ApiKeyPermissions"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "revoked"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "key": {
            "type": "string",
            "title": "Key",
            "description": "The full API key. Shown only once; store it securely."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "notes",
          "prefix",
          "permissions",
          "status",
          "created_at",
          "expires_at",
          "last_used_at",
          "revoked_at",
          "key"
        ],
        "title": "ApiKeyCreated"
      },
      "ApiKeyOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "prefix": {
            "type": "string",
            "title": "Prefix",
            "description": "First characters of the key, to tell keys apart. Not secret."
          },
          "permissions": {
            "$ref": "#/components/schemas/ApiKeyPermissions"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "revoked"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "notes",
          "prefix",
          "permissions",
          "status",
          "created_at",
          "expires_at",
          "last_used_at",
          "revoked_at"
        ],
        "title": "ApiKeyOut"
      },
      "ApiKeyPermissions": {
        "properties": {
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version",
            "default": 1
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/Scope"
            },
            "type": "array",
            "minItems": 1,
            "title": "Scopes",
            "description": "Actions the key may perform."
          },
          "projects": {
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,19}$",
              "examples": [
                "SEC"
              ]
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Projects",
            "description": "Jira projects the key may create tickets in.",
            "examples": [
              [
                "SEC"
              ]
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scopes",
          "projects"
        ],
        "title": "ApiKeyPermissions",
        "description": "What a key may do. Validated the same way when created and every time it is used."
      },
      "ApiKeyUpdate": {
        "properties": {
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes",
            "description": "What the key is used for. Editable later."
          }
        },
        "additionalProperties": false,
