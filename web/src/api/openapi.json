          }
        },
        "type": "object",
        "required": [
          "key",
          "summary",
          "url",
          "created_at"
        ],
        "title": "RecentTicket"
      },
      "SelectSiteIn": {
        "properties": {
          "cloud_id": {
            "type": "string",
            "title": "Cloud Id"
          }
        },
        "type": "object",
        "required": [
          "cloud_id"
        ],
        "title": "SelectSiteIn"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ],
        "title": "Severity"
      },
      "SiteOut": {
        "properties": {
          "cloud_id": {
            "type": "string",
            "title": "Cloud Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "cloud_id",
          "name",
          "url"
        ],
        "title": "SiteOut"
      },
      "UserCreate": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "is_active": {
            "anyOf": [
