# Copy to .env, or run `python3 scripts/init_env.py` to generate one with fresh secrets.

# Public URL of the app as seen by the browser. Cookies are marked Secure when this is https.
APP_BASE_URL=http://localhost:8000

# Where the browser UI lives, if not APP_BASE_URL. Only needed with the Vite dev server.
# UI_BASE_URL=http://localhost:5173

# "development" also serves the full API schema at /docs (internal endpoints included).
# ENVIRONMENT=production

# Signs session and CSRF cookies. At least 32 characters.
SECRET_KEY=

# Comma-separated Fernet keys that encrypt Jira tokens at rest (rotation: DESIGN.md section 10).
ENCRYPTION_KEYS=

# Days to keep IdentityHub's audit record of created tickets (Jira keeps the tickets themselves).
# FINDING_RETENTION_DAYS=365

# Atlassian OAuth 2.0 (3LO) app - see README "Create the Atlassian OAuth app".
# Callback URL to register: ${APP_BASE_URL}/api/jira/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# --- Optional: NHI Blog Digest --------------------------------------------------------------------
# Tickets are filed with the subscriber's own Jira connection; nothing to configure for that.
# Daily run time (HH:MM, UTC); the server also catches up shortly after it starts. Each run starts
# at a random time up to DIGEST_JITTER_MINUTES later, to spread load on Jira.
# DIGEST_DAILY_AT=09:00
# DIGEST_JITTER_MINUTES=30

# Who writes the summaries: "auto" uses Claude if ANTHROPIC_API_KEY is set, else a local Ollama
# model if reachable (`docker compose --profile llm up`), else a built-in extractive summary.
# LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# OLLAMA_MODEL=llama3.2:3b
