# Copy to .env, or run `python3 scripts/init_env.py` to generate one with fresh secrets.

# Public URL of the app as seen by the browser. Cookies are marked Secure when this is https.
APP_BASE_URL=http://localhost:8000

# Where the browser UI lives, if not APP_BASE_URL. Only needed with the Vite dev server.
# UI_BASE_URL=http://localhost:5173

# Signs session and CSRF cookies. At least 32 characters.
SECRET_KEY=

# Comma-separated Fernet keys that encrypt Jira tokens at rest. Prepend a new key to rotate.
ENCRYPTION_KEYS=

# Atlassian OAuth 2.0 (3LO) app - see README "Create the Atlassian OAuth app".
# Callback URL to register: ${APP_BASE_URL}/api/jira/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# --- Optional: NHI Blog Digest --------------------------------------------------------------------
# A dedicated Atlassian account ("IdentityHub" bot) that files the digest tickets, with an API token
# from https://id.atlassian.com/manage-profile/security/api-tokens. The digest is off until all
# three are set. A Jira admin must let the bot create issues in the projects users subscribe.
DIGEST_JIRA_SITE_URL=
DIGEST_JIRA_EMAIL=
DIGEST_JIRA_API_TOKEN=
# DIGEST_INTERVAL_HOURS=24

# Who writes the summaries: "auto" uses Claude if ANTHROPIC_API_KEY is set, else a local Ollama
# model if reachable (`docker compose --profile llm up`), else a built-in extractive summary.
# LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# OLLAMA_MODEL=llama3.2:3b
